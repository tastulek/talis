   "source": [
    "#Q10: \n",
    "#How much Biomass Energy was consumed by the US electric power sector in 2018 above its average over the 6 years?\n",
    "bioMassAverage = energy_avg('Biomass Energy')\n",
    "bioMass18 = project.get_consumption(bioIndex, 2018)\n",
    "bioPercent = (bioMass18 - bioMassAverage)/bioMassAverage * 100\n",
    "\n",
    "bioPercent\n"
   ]
