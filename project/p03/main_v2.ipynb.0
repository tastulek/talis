   "source": [
    "# Function 4: year_sum(year)\n",
    "# This function should compute the total renewable energy consumption of the US electric power sector \n",
    "#(over the five sources) in a given year.\n",
    "\n",
    "def year_sum(year = 2016):\n",
    "    \n",
    "    hydro_use = project.get_consumption(hydroIndex, year)\n",
    "    solar_use = project.get_consumption(solarIndex, year)\n",
    "    wind_use = project.get_consumption(windIndex, year)\n",
    "    wood_use = project.get_consumption(woodIndex, year)\n",
    "    bio_use = project.get_consumption(bioIndex, year)\n",
    "    \n",
    "    all_use = (hydro_use + solar_use + wind_use + wood_use + bio_use)\n",
    "    \n",
    "    return all_use "
   ]
  },
