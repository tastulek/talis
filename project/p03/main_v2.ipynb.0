   "source": [
    "# Function 2: energy_min(source)\n",
    "# This function is for finding minimum amount of energy for a given \n",
    "# energy source in all years;\n",
    "\n",
    "def energy_min (source):\n",
    "    #getting the index for the source of energy:\n",
    "    source_index = project.get_idx(source)\n",
    "    \n",
    "    #getting the amount of energy used each year:\n",
    "    y15 = project.get_consumption(source_index, 2015)\n",
    "    y16 = project.get_consumption(source_index, 2016)\n",
    "    y17 = project.get_consumption(source_index, 2017)\n",
    "    y18 = project.get_consumption(source_index, 2018)\n",
    "    y19 = project.get_consumption(source_index, 2019)\n",
    "    y20 = project.get_consumption(source_index, 2020)\n",
    "    \n",
    "    return min(y15, y16, y16, y17, y18, y19, y20)\n"
   ]
  },
