   "id": "b7533382",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Function 5: change_per_year(energy, start_year, end_year)\n",
    "# This function should return the average increase in consumption (could be negative if there's a decrease) over the period from start_year to end_year for \n",
    "# the given energy source (example energy source: \"Solar Energy\").\n",
    "\n",
    "def change_per_year(energy, start_year = 2015, end_year = 2020):\n",
    "    \n",
    "    #getting the index for the source of energy:\n",
    "    source_index = project.get_idx(energy)\n",
    "    \n",
    "    #getting the amount of energy used each year:\n",
    "    y15 = project.get_consumption(source_index, 2015)\n",
    "    y16 = project.get_consumption(source_index, 2016)\n",
    "    y17 = project.get_consumption(source_index, 2017)\n",
    "    y18 = project.get_consumption(source_index, 2018)\n",
    "    y19 = project.get_consumption(source_index, 2019)\n",
    "    y20 = project.get_consumption(source_index, 2020)\n",
    "    \n",
    "    y15_16 = y16 - y15\n",
    "    y16_17 = y17 - y16\n",
    "    y17_18 = y18 - y17\n",
    "    y18_19 = y19 - y18\n",
    "    y19_20 = y20 - y19\n",
    "    \n",
    "    average_increase = (y15_16 + y16_17 + y17_18 + y18_19 + y19_20)/5\n",
    "    \n",
    "    return average_increase\n",
    "    "
   ]
  },
