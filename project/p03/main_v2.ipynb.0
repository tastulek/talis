   "source": [
    "#for getting index for each energy source:\n",
    "bioIndex = project.get_idx ('Biomass Energy')\n",
    "hydroIndex = project.get_idx ('Conventional Hydroelectric Power')\n",
    "solarIndex = project.get_idx ('Solar Energy')\n",
    "windIndex = project.get_idx ('Wind Energy')\n",
    "woodIndex = project.get_idx ('Wood Energy')\n",
    "\n",
    "print('hydroIndex:', hydroIndex)\n",
    "print('bioIndex:', bioIndex)\n",
    "print('solarIndex:', solarIndex)\n",
    "print('windIndex:', windIndex)\n",
    "print('woodIndex:', woodIndex)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "ee1e2d4d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Function 1: year_max(year)\n",
    "# This function is for finding maximum amount of energy consumed\n",
    "# in a given year when all engery sources being considered;\n",
    "\n",
    "\n",
    "def year_max(year):\n",
    "    # grab the consumption of each energy source in the given year\n",
    "    hydro_use = project.get_consumption(hydroIndex, year)\n",
    "    solar_use = project.get_consumption(solarIndex, year)\n",
    "    wind_use = project.get_consumption(windIndex, year)\n",
    "    wood_use = project.get_consumption(woodIndex, year)\n",
    "    bio_use = project.get_consumption(bioIndex, year)\n",
    "    \n",
    "    return max(hydro_use, solar_use, wind_use, wood_use, bio_use)"
   ]
  },
